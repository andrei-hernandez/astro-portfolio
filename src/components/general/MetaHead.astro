---
import { IMetaHead } from "@types";
import { info } from "@data";
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import { alternatePath } from "@i18n";

const altLang = Astro.currentLocale === "es" ? "en" : "es";

const { title, description, ogImageUrl } = Astro.props as IMetaHead;
---

<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
<meta name="msapplication-TileColor" content="#da532c" />
<meta name="theme-color" content="#111111" />

<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
{
  title && (
    <link rel="canonical" href={`${new URL(Astro.url.pathname, Astro.site)}`} />
  )
}
<link rel="alternate" hreflang={Astro.currentLocale} href={`${new URL(Astro.url.pathname, Astro.site)}`} />
<link rel="alternate" hreflang={altLang} href={`${new URL(alternatePath(Astro.url.pathname, Astro.currentLocale), Astro.site)}`} />
{title && <title>{`${title} - ${info.name}`}</title>}
{title && <meta name="title" content={`${title} - ${info.name}`} />}
{description && <meta name="description" content={description} />}

<!-- Open Graph / Facebook -->
{title && <meta property="og:type" content="website" />}
{
  title && (
    <meta property="og:url" content={`${new URL(Astro.url.pathname, Astro.site)}`} />
  )
}
{title && <meta property="og:title" content={`${title} - ${info.name}`} />}
{description && <meta property="og:description" content={description} />}
{
  ogImageUrl && (
    <meta property="og:image" content={`${new URL(ogImageUrl, Astro.site)}`} />
  )
}

<!-- Twitter -->
{title && <meta property="twitter:card" content="summary_large_image" />}
{
  title && (
    <meta
      property="twitter:url"
      content={`${new URL(Astro.url.pathname, Astro.site)}`}
    />
  )
}
{title && <meta property="twitter:title" content={`${title} - ${info.name}`} />}
{description && <meta property="twitter:description" content={description} />}
{
  ogImageUrl && (
    <meta property="twitter:image" content={`${new URL(ogImageUrl, Astro.site)}`} />
  )
}

<Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
<Font cssVariable="--font-outfit" preload={[{ weight: 600 }]} />

<ClientRouter />