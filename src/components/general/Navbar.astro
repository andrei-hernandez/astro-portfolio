---
import { useTranslations, alternatePath } from "@i18n";
const t = useTranslations(Astro.currentLocale);
const home = Astro.currentLocale === "es" ? "/es/" : "/";
import { info } from "@data";
import { createLogo } from "@utils";
---

<header
  class="container z-10 bg-dark flex items-center justify-between h-[80px] sm:h-[123px] md:sticky md:pt-2 md:top-0"
>
  <a
    class="text-2xl dark:text-light font-semibold dark:font-semibold font-outfit"
    href={home}
    >{createLogo(info.name)}.
  </a>
  <nav class="hidden md:block">
    <ul class="flex items-center">     
      <li>
        <a class="nav-anchor" href={`${home}#about`}>
          {t("nav.about")}
        </a>
      </li>
      <li>
        <a class="nav-anchor" href={`${home}#projects`}
          >{t("nav.projects")}</a
        >
      </li>
      <li>
        <a class="nav-anchor" href={`${home}#tech-stack`}>
          {t("nav.techStack")}
        </a>
      </li>
      <li>
        <a class="nav-anchor" href={`${home}#contact`}>
          {t("nav.contact")}
        </a>
      </li>
    </ul>
  </nav>
  <a
    class="nav-anchor"
    href={alternatePath(Astro.url.pathname, Astro.currentLocale)}
    hreflang={Astro.currentLocale === "es" ? "en" : "es"}
  >
    {t("nav.switch")}
  </a>
</header>

<style>
  @reference "../../styles/style.css";
  .nav-anchor {
    @apply p-4 dark:text-light block text-lg
  }
</style>
