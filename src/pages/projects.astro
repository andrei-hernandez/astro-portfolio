---
import { getInfo, useTranslations } from "@i18n";
const info = getInfo(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);

import ProjectsWrapper from "@components/general/ProjectsWrapper.astro";
import MetaHead from "@components/general/MetaHead.astro";
import Layout from "@layouts/Layout.astro";

---

<!DOCTYPE html>
<html lang={Astro.currentLocale} data-theme="dark">
  <head>    
    <MetaHead
      title={t("projects.title")}
      description={t("projects.description")}
    />
  </head>

  <body>
    <Layout transition:name="project-detail">
      <h1 class="main-heading" style="line-height: 1.2;">{t("projects.title")}</h1>
      <ProjectsWrapper projects={info.projects} />
    </Layout>
  </body>
</html>
